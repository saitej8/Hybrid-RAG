# Copy these into your app's "Secrets" panel on share.streamlit.io
# (Settings → Secrets, paste as plain TOML — no quotes around section headers)

# --- Required: at least one Google API key -----------------------------
# Use GOOGLE_API_KEY for a single key, or GOOGLE_API_KEYS (comma-separated)
# for automatic rotation when one hits a quota limit.
GOOGLE_API_KEY = ""
GOOGLE_API_KEYS = ""

# --- Optional: model + retrieval tuning --------------------------------
GEMINI_MODEL = "gemini-flash-lite-latest"
EMBEDDING_MODEL = "models/embedding-001"

LLM_TEMPERATURE = "0.2"
LLM_MAX_OUTPUT_TOKENS = "2048"

RETRIEVAL_K = "5"
HYBRID_DENSE_WEIGHT = "0.6"
HYBRID_SPARSE_WEIGHT = "0.4"

ENABLE_STREAMING = "true"
ENABLE_EVALUATION = "true"

# --- Optional: turn off file logging on Streamlit Cloud (recommended) --
# Streamlit Cloud's filesystem is ephemeral — log to stdout only.
# LOG_FILE = ""
